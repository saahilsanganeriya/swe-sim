{{ base_stage }}
USER root
ENV DEBIAN_FRONTEND=noninteractive
# build-essential: Harbor's mini-swe-agent setup checks for gcc/make and otherwise runs apt-get inside the sandbox, where the
# strict allowlist blocks it (observed on the python@digest pypdf image: NetworkConnectionError before the agent started).
RUN apt-get update && apt-get install -y --no-install-recommends curl bash git ca-certificates procps build-essential && rm -rf /var/lib/apt/lists/*
RUN if id agent >/dev/null 2>&1; then echo 'agent user pre-exists in base image; rejected for this pilot' >&2; exit 1; fi && useradd -m agent
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh && uv --version
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv python install {{ agent_python }} && ln -s "$(uv python find {{ agent_python }})" /usr/local/bin/swesim-python && /usr/local/bin/swesim-python -I -c 'import sys; print(sys.version)'
# Assert the prepared checkout, apply the submodule rule (declared paths empty, placeholders removed), then record the
# base file manifest (the verifier image runs the same steps and records the same one).
RUN cd {{ repo_dir_q }} && test "$(git rev-parse HEAD)" = {{ base_commit }} \
 && {{ submodule_guard }} \
 && mkdir -p /opt/swesim && find . -path ./.git -prune -o -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum > /opt/swesim/base-manifest.txt
# A new base-only git object database removes remote refs, future objects and reflogs.
RUN cd {{ repo_dir_q }} && rm -rf .git && git init -q && git config user.name swesim && git config user.email swesim@localhost \
 && git add -A && git -c core.hooksPath=/dev/null commit -qm 'scenario base' && git reflog expire --expire=now --all
RUN mkdir -p /opt/swesim/bin /var/swesim-collect && chmod 700 /var/swesim-collect
COPY collect.py /opt/swesim/collect.py
COPY shims/ask-user shims/confirm-behavior shims/request-review /opt/swesim/bin/
RUN chmod 755 /opt/swesim/collect.py /opt/swesim/bin/* && ln -s /opt/swesim/bin/ask-user /usr/local/bin/ask-user && ln -s /opt/swesim/bin/confirm-behavior /usr/local/bin/confirm-behavior && ln -s /opt/swesim/bin/request-review /usr/local/bin/request-review
RUN chown -R agent:agent {{ repo_dir_q }} /home/agent
USER agent
ENV HOME=/home/agent
ENV UV_PYTHON_INSTALL_DIR=/home/agent/.local/share/uv/python
RUN uv python install {{ agent_python }} && uv tool install --python {{ agent_python }} 'mini-swe-agent=={{ agent_version }}' --with litellm --with orjson --with fastapi \
 && /home/agent/.local/bin/mini-swe-agent --help >/dev/null && echo 'export PATH="$HOME/.local/bin:$PATH"' >> /home/agent/.bashrc
USER root
RUN chown -R agent:agent /home/agent && chmod -R u+rwX /home/agent
WORKDIR {{ repo_dir }}
