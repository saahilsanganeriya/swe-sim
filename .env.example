# swesim environment file. Copy to ./.env (git-ignored) or point SWESIM_ENV_FILE at your copy.
# Read with python-dotenv; never `export $(cat ...)` or `source` it. Secrets are marked; keep them out of git.

# Path of this file; set it in the process environment, not here.
SWESIM_ENV_FILE=./.env

# Record root: local directory or the mounted bucket (/workspace on Cloud Run).
SWESIM_WORKSPACE=./workspace

# Path of registry.json (the file record of valid scenarios).
SWESIM_REGISTRY=./registry.json

# GCS bucket name that holds the record (no gs:// prefix). Empty = files only.
#   where: Terraform output `bucket`.
SWESIM_BUCKET=

# SQLAlchemy URL of the Postgres index; empty disables the index. [secret]
#   where: Terraform output `database_url_template` plus the DB_PASSWORD secret; on Cloud Run the Cloud SQL unix socket URL.
SWESIM_DATABASE_URL=

# Comma list of Temporal task queues this worker polls; `all` for every queue.
SWESIM_TASK_QUEUE=all

# Override of the per-queue activity concurrency (swesim/workflows/queues.py).
SWESIM_MAX_CONCURRENT_ACTIVITIES=

# systemd (VM) | cloudrun (production) | subprocess (local smoke only).
SWESIM_TRIAL_LAUNCHER=systemd

# Label written into every record: laptop | vm-systemd | cloudrun.
SWESIM_ORIGIN=laptop

# Digest of the running worker image; set by the deploy, recorded in every result.
#   where: Set by Terraform on the worker pools and Jobs.
SWESIM_WORKER_IMAGE_DIGEST=

# GCP project id (Cloud Run Jobs, Secret Manager).
#   where: `gcloud config get project`.
SWESIM_GCP_PROJECT=

# GCP region for Cloud Run Jobs.
SWESIM_GCP_REGION=us-central1

# Full worker image reference with digest (<repo>/worker@sha256:...) used for trial Jobs.
#   where: Printed by `make build`; set by Terraform on the pools.
SWESIM_WORKER_IMAGE=

# Service account email the trial Jobs run as.
#   where: Terraform output `worker_service_account`.
SWESIM_WORKER_SERVICE_ACCOUNT=

# Cloud SQL connection mounted in trial and maintenance Jobs.
#   where: Terraform output `sql_connection_name`.
SWESIM_SQL_CONNECTION_NAME=

# IAP JWT audience of the console service (/projects/<num>/locations/<region>/services/<name>); empty = no IAP.
#   where: Terraform output `iap_audience`.
SWESIM_IAP_AUDIENCE=

# Optional comma-separated OAuth client IDs for authenticated console automation; IAP still checks user access.
#   where: Your OAuth client ID or the audience of your Google Cloud CLI identity token.
SWESIM_IAP_PROGRAMMATIC_CLIENTS=

# Comma list of Google account emails allowed to see evaluator-only material in the console.
#   where: Your own IAP-allowlisted accounts.
SWESIM_EVALUATORS=

# RunTasksWorkflow stops planning new trials when recorded spend exceeds this (USD).
SWESIM_SPEND_CAP_USD=

# Base URL of the stakeholder service deployed to Modal.
#   where: Printed by `bash scripts/deploy_stakeholder.sh`.
SWESIM_STAKEHOLDER_URL=

# Public URL of the console (used in links and notifications).
#   where: Terraform output `console_url`.
SWESIM_CONSOLE_URL=

# Base URL of the Temporal UI for deep links; derived for Temporal Cloud when empty.
SWESIM_TEMPORAL_UI_URL=

# Temporal gRPC endpoint.
#   where: Temporal Cloud namespace page, e.g. us-central1.gcp.api.temporal.io:7233.
TEMPORAL_ADDRESS=localhost:7233

# Temporal namespace.
#   where: Temporal Cloud namespace page, e.g. swesim.abcde.
TEMPORAL_NAMESPACE=default

# Temporal Cloud API key (TLS on when present). [secret]
#   where: Temporal Cloud > Settings > API keys, or `temporal cloud apikey create`.
TEMPORAL_API_KEY=

# HMAC secret shared by the worker and the stakeholder service (any 32+ random bytes, hex). [secret]
#   where: `python -c 'import secrets; print(secrets.token_hex(32))'`.
SWESIM_WORKER_SECRET=

# Anthropic API key (judge, drafter, stakeholder, Anthropic solvers). [secret]
#   where: console.anthropic.com.
ANTHROPIC_API_KEY=

# OpenAI API key (fallback roles, OpenAI solvers). [secret]
#   where: platform.openai.com.
OPENAI_API_KEY=

# OpenRouter API key (open-model solvers). [secret]
#   where: openrouter.ai/keys.
OPENROUTER_API_KEY=

# Read-only GitHub token for repository discovery (public_repo scope is enough). [secret]
#   where: `gh auth token` or github.com/settings/tokens.
GH_TOKEN=

# Modal token id (Harbor's Modal backend, stakeholder deploy). [secret]
#   where: modal.com/settings or ~/.modal.toml.
MODAL_TOKEN_ID=

# Modal token secret. [secret]
#   where: modal.com/settings or ~/.modal.toml.
MODAL_TOKEN_SECRET=
