+"""
+Test to verify that color mapping works with boolean data.
+This tests the fix for the issue: "Color mapping fails with boolean data"
+"""
+
+import sys
+import traceback
+
+# Try importing necessary modules
+try:
+    import pandas as pd
+    import numpy as np
+    from seaborn._core.scales import Continuous
+    from seaborn._core.properties import Color
+    from seaborn.palettes import color_palette
+    print("✓ All imports successful")
+except ImportError as e:
+    print(f"✗ Import error: {e}")
+    sys.exit(1)
+
+def test_boolean_color_mapping():
+    """Test that boolean data can be used for color mapping"""
+    try:
+        # Create a boolean series
+        x = pd.Series([True, False, True], name="x", dtype=bool)
+        print(f"✓ Created boolean series: {x.tolist()}")
+        
+        # Setup continuous scale with boolean data and Color property
+        cmap = color_palette("ch:", as_cmap=True)
+        s = Continuous()._setup(x, Color())
+        print("✓ Scale setup successful")
+        
+        # Apply the scale to the data
+        result = s(x)
+        print(f"✓ Scale applied successfully")
+        print(f"  Result shape: {result.shape}")
+        print(f"  Result: {result}")
+        
+        # Verify the result is reasonable (should be RGB colors)
+        assert result.shape == (3, 3), f"Expected shape (3, 3), got {result.shape}"
+        print("✓ Result shape is correct")
+        
+        return True
+    except Exception as e:
+        print(f"✗ Test failed with error:")
+        traceback.print_exc()
+        return False
+
+def test_boolean_interval_property():
+    """Test that boolean data can be used for interval property"""
+    try:
+        from seaborn._core.properties import IntervalProperty
+        
+        # Create a boolean series
+        x = pd.Series([True, False, True], name="x", dtype=bool)
+        print(f"✓ Created boolean series: {x.tolist()}")
+        
+        # Setup continuous scale with boolean data and IntervalProperty
+        s = Continuous()._setup(x, IntervalProperty())
+        print("✓ Scale setup successful with IntervalProperty")
+        
+        # Apply the scale to the data
+        result = s(x)
+        print(f"✓ Scale applied successfully")
+        print(f"  Result: {result.tolist()}")
+        
+        return True
+    except Exception as e:
+        print(f"✗ Test failed with error:")
+        traceback.print_exc()
+        return False
+
+if __name__ == "__main__":
+    print("\n" + "="*60)
+    print("Test 1: Boolean Color Mapping")
+    print("="*60)
+    test1_passed = test_boolean_color_mapping()
+    
+    print("\n" + "="*60)
+    print("Test 2: Boolean Interval Property")
+    print("="*60)
+    test2_passed = test_boolean_interval_property()
+    
+    print("\n" + "="*60)
+    print("Summary")
+    print("="*60)
+    if test1_passed and test2_passed:
+        print("✓ All tests passed!")
